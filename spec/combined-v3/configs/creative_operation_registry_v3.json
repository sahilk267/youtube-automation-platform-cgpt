      "owner_service": "asset_service",
      "input_contract": "Rights-approved shots + compute capability",
      "output_contract": "ShotPlan",
      "algorithm": "Generate original diagrams or use authorized assets; GPU only if tested/available. Mandatory clip-review guard returns signed NOT_APPLICABLE if no third-party clips; otherwise requires reviewed ReactionClipMap.",
      "failure_code": "MEDIA_OR_CAPABILITY_MISSING",
      "gate": "AUTOMATIC_WHEN_ALLOWED",
      "depends_on": [
        "CV3-06",
        "CV3-07"
      ],
      "conditional_on": "ALWAYS",
      "implementation_status": "SPECIFIED_NOT_IMPLEMENTED",
      "test_id": "T-CV3-08"
    },

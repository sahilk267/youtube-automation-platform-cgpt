      "short_name": "BEAT_PLAN",
      "owner_service": "creative_director",
      "input_contract": "CreativeBrief + evidence lock",
      "output_contract": "TimedBeatGraph",
      "algorithm": "Ask/promise, evidence, uncertainty, payoff, and duration ranges; mark claims by ID.",
      "failure_code": "UNSUPPORTED_BEAT",
      "gate": "AUTOMATIC_WITH_REVIEW",
      "depends_on": [
        "CV3-02",
        "CV3-03"
      ],
      "conditional_on": "ALWAYS",
      "implementation_status": "SPECIFIED_NOT_IMPLEMENTED",
      "test_id": "T-CV3-04"
    },
    {
      "id": "CV3-05",
      "short_name": "SHOT_PLAN",
      "owner_service": "shot_planner",
      "input_contract": "TimedBeatGraph + domain/format pack",
      "output_contract": "ShotPlan",
      "algorithm": "Visual class, permitted source, image/video overlay, speech cue, motion, source & rights dependencies.",
      "failure_code": "UNEXPLAINED_SHOT",
      "gate": "AUTOMATIC_WITH_REVIEW",
      "depends_on": [
        "CV3-04"
      ],
      "conditional_on": "ALWAYS",
      "implementation_status": "SPECIFIED_NOT_IMPLEMENTED",
      "test_id": "T-CV3-05"
    },

      "owner_service": "reaction_director",
      "input_contract": "Original source context + documented rights + commentary",
      "output_contract": "ReactionClipMap",
      "algorithm": "Require real new independent critique and source-to-commentary link. No generic green-screen license. When source clips are absent, record NOT_APPLICABLE as a durable guard result; downstream stages must not treat a skipped required guard as approval.",
      "failure_code": "REUPLOAD_NOT_AUTHORIZED",
      "gate": "HUMAN_FOR_SOURCE_CLIPS",
      "depends_on": [
        "CV3-06"
      ],
      "conditional_on": "HAS_THIRD_PARTY_CLIP",
      "implementation_status": "SPECIFIED_NOT_IMPLEMENTED",
      "test_id": "T-CV3-07"
    },
    {

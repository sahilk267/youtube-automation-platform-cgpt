{
  "spec_revision": "3.0",
  "purpose": "Normative production-operation extensions, not code or proofs",
  "operations": [
    {
      "id": "CV3-01",
      "short_name": "BRIEF",
      "owner_service": "creative_director",
      "input_contract": "ChannelProfile + ResearchDossier + BrandPack",
      "output_contract": "CreativeBrief",
      "algorithm": "Provenance-aware question and original angle; reject unrelated or near-duplicate video concept.",
      "failure_code": "NO_ORIGINAL_VALUE",
      "gate": "LOW_RISK_AUTO",
      "depends_on": [],
      "conditional_on": "ALWAYS",
      "implementation_status": "SPECIFIED_NOT_IMPLEMENTED",
      "test_id": "T-CV3-01"
    },
    {
      "id": "CV3-02",
      "short_name": "CLAIM_LOCK",
      "owner_service": "research_engine",
      "input_contract": "ResearchDossier + Claims + EvidenceEdges",
      "output_contract": "ResearchDossier (v2: immutable verified revision + evidence/source IDs)",
      "algorithm": "Freeze permitted factual claims; missing critical source blocks production.",
      "failure_code": "EVIDENCE_UNAVAILABLE",
      "gate": "REVIEW_WHEN_DISPUTED",
      "depends_on": [
        "CV3-01"
      ],
      "conditional_on": "ALWAYS",
      "implementation_status": "SPECIFIED_NOT_IMPLEMENTED",
      "test_id": "T-CV3-02"
    },
    {
      "id": "CV3-03",
      "short_name": "DOMAIN_STYLE",
      "owner_service": "domain_router",
      "input_contract": "CreativeBrief + domain creative profile",
      "output_contract": "DomainCreativeProfile",
      "algorithm": "Load real domain visual/voice rules; no generic theme swap or disabled domain.",
      "failure_code": "DOMAIN_NOT_ENABLED",
      "gate": "AUTOMATIC",
      "depends_on": [
        "CV3-01"
      ],
      "conditional_on": "ALWAYS",
      "implementation_status": "SPECIFIED_NOT_IMPLEMENTED",
      "test_id": "T-CV3-03"
    },
    {

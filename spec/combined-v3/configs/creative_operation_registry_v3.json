      "id": "CV3-06",
      "short_name": "RIGHTS_CHECK",
      "owner_service": "asset_service",
      "input_contract": "ShotPlan + AssetRights + source versions",
      "output_contract": "AssetRights (v2) + reviewed ShotPlan rights IDs",
      "algorithm": "Delegate adjudication to existing rights service, unknown legal basis -> HOLD.",
      "failure_code": "UNKNOWN_RIGHTS",
      "gate": "HUMAN_FOR_THIRD_PARTY",
      "depends_on": [
        "CV3-05"
      ],
      "conditional_on": "ALWAYS",
      "implementation_status": "SPECIFIED_NOT_IMPLEMENTED",
      "test_id": "T-CV3-06"
    },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viralos.local/contracts/AnalyticsObservation.schema.json",
  "title": "AnalyticsObservation",
  "description": "Observed authorized Analytics data or explicit unavailable state.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "channel_id": {
      "type": "string",
      "format": "uuid"
    },
    "youtube_video_id": {
      "type": "string"
    },
    "metric_name": {
      "type": "string"
    },
    "metric_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": "string"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "availability": {
      "enum": [
        "OBSERVED",
        "NOT_AUTHORIZED",
        "NOT_ELIGIBLE",
        "NOT_AVAILABLE",
        "PENDING"
      ]
    },
    "source": {
      "type": "string"
    },
    "format": {
      "enum": [
        "SHORT",
        "LONG"
      ]
    },
    "synthetic_test_fixture": {
      "type": "boolean"
    }
  },
  "required": [
    "contract_version",
    "snapshot_id",
    "channel_id",
    "youtube_video_id",
    "metric_name",
    "unit",
    "window_start",
    "window_end",
    "observed_at",
    "availability",
    "source",
    "format",
    "synthetic_test_fixture"
  ]
}

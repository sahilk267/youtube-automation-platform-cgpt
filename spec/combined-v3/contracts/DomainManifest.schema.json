{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viralos.local/contracts/DomainManifest.schema.json",
  "title": "DomainManifest",
  "description": "One plugin per domain. Plugins cannot directly publish or duplicate core source registry.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "domain_id": {
      "enum": [
        "newsroom",
        "science",
        "technology",
        "business",
        "gaming",
        "history",
        "space",
        "learning",
        "sports",
        "career",
        "productivity",
        "culture"
      ]
    },
    "plugin_version": {
      "type": "string"
    },
    "engine_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_provider_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_policy_id": {
      "type": "string"
    },
    "source_policy_id": {
      "type": "string"
    },
    "required_fixture_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supports_cpu": {
      "type": "boolean"
    },
    "may_publish_directly": {
      "const": false
    },
    "state": {
      "enum": [
        "DISABLED",
        "SPECIFIED",
        "ENABLED",
        "VERIFIED"
      ]
    }
  },
  "required": [
    "contract_version",
    "domain_id",
    "plugin_version",
    "engine_ids",
    "source_provider_ids",
    "visual_policy_id",
    "source_policy_id",
    "required_fixture_ids",
    "supports_cpu",
    "may_publish_directly",
    "state"
  ]
}

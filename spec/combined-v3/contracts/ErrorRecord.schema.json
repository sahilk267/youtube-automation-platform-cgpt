{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-os.local/contracts/ErrorRecord.schema.json",
  "title": "ErrorRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "error_id",
    "code",
    "severity",
    "retryable",
    "safe_message",
    "recovery_action",
    "trace_id"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "error_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "safe_message": {
      "type": "string"
    },
    "recovery_action": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "source_system": {
      "type": [
        "string",
        "null"
      ]
    },
    "redacted_context": {
      "type": "object"
    }
  }
}

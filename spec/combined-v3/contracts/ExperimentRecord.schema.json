{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-os.local/contracts/ExperimentRecord.schema.json",
  "title": "ExperimentRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "experiment_id",
    "channel_id",
    "hypothesis",
    "status",
    "created_at"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "experiment_id": {
      "type": "string"
    },
    "channel_id": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "RUNNING",
        "COMPLETED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "variant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "measurement_window_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "measurement_window_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "result_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

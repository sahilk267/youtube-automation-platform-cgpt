{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.viral-os.local/v3/SpeechSegment.schema.json",
  "title": "SpeechSegment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "3.0.0"
    },
    "speech_id": {
      "type": "string",
      "minLength": 1
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})+$"
    },
    "voice_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "spoken_text": {
      "type": "string",
      "minLength": 1
    },
    "voice_rights_id": {
      "type": "string",
      "minLength": 1
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "end_ms": {
      "type": "integer",
      "minimum": 1
    },
    "audio_asset_id": {
      "type": "string",
      "minLength": 1
    },
    "audio_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "style": {
      "type": "string",
      "enum": [
        "NEUTRAL",
        "ENERGETIC",
        "SERIOUS",
        "EDUCATIONAL",
        "CONVERSATIONAL",
        "DRAMATIC_RESTRAINED"
      ]
    },
    "alignment_method": {
      "type": "string",
      "enum": [
        "MEASURED_TOOL",
        "HUMAN_VERIFIED",
        "UNVERIFIED"
      ]
    },
    "word_alignment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "text",
          "start_ms",
          "end_ms"
        ]
      }
    },
    "pronunciation_review": {
      "type": "string",
      "enum": [
        "PENDING",
        "PASS",
        "FAIL"
      ]
    }
  },
  "required": [
    "contract_version",
    "speech_id",
    "story_id",
    "locale",
    "voice_profile_id",
    "spoken_text",
    "voice_rights_id",
    "start_ms",
    "end_ms",
    "audio_asset_id",
    "audio_sha256",
    "style",
    "alignment_method",
    "word_alignment",
    "pronunciation_review"
  ]
}

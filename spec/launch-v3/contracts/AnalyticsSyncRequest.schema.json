{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-os.local/contracts/AnalyticsSyncRequest.schema.json",
  "title": "AnalyticsSyncRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "channel_id",
    "start_date",
    "end_date"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "channel_id": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

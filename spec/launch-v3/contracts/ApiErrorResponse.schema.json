{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiErrorResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "contract_version",
    "error"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "contract_version": {
      "const": "2.0.0"
    },
    "error": {
      "$ref": "./ErrorRecord.schema.json"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-os.local/contracts/ConnectorSyncRequest.schema.json",
  "title": "ConnectorSyncRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "market",
    "locale",
    "source_query",
    "max_items"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "market": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "source_query": {
      "type": "string"
    },
    "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

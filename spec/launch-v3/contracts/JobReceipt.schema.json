{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-os.local/contracts/JobReceipt.schema.json",
  "title": "JobReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "job_id",
    "state",
    "accepted_at_utc"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "job_id": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "BLOCKED",
        "WAITING_FOR_CAPABILITY",
        "WAITING_FOR_APPROVAL"
      ]
    },
    "accepted_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

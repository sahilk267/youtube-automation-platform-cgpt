{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-os.local/contracts/ScriptUpdateRequest.schema.json",
  "title": "ScriptUpdateRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "expected_project_revision",
    "script_text",
    "claim_links"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "expected_project_revision": {
      "type": "integer",
      "minimum": 1
    },
    "script_text": {
      "type": "string",
      "minLength": 1
    },
    "claim_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "start",
          "end"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}

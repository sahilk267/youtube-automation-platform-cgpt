{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viralos.local/contracts/TopicObservation.schema.json",
  "title": "TopicObservation",
  "description": "Immutable actual observation with coverage state and nullable actual metric.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "observation_id": {
      "type": "string",
      "format": "uuid"
    },
    "topic_id": {
      "type": "string",
      "format": "uuid"
    },
    "provider_id": {
      "type": "string"
    },
    "source_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "market": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "metric_name": {
      "type": "string"
    },
    "metric_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "metric_unit": {
      "type": "string"
    },
    "external_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage_state": {
      "enum": [
        "VERIFIED_ACCESS",
        "DEGRADED",
        "BLOCKED",
        "NOT_CONFIGURED",
        "NO_DATA"
      ]
    },
    "source_latency_sec": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "contract_version",
    "observation_id",
    "topic_id",
    "provider_id",
    "observed_at",
    "market",
    "locale",
    "metric_name",
    "metric_unit",
    "coverage_state"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.viral-os.local/v3/CreativeOperationRequest.schema.json",
  "title": "CreativeOperationRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "3.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^CV3-[0-9]{2}$"
    },
    "channel_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "input_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_revision_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "edition_profile": {
      "type": "string",
      "enum": [
        "LAUNCH",
        "ULTIMATE",
        "COMBINED"
      ]
    },
    "allow_external_side_effect": {
      "type": "boolean"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "operation_id",
    "channel_id",
    "project_id",
    "input_artifact_ids",
    "expected_revision_sha256",
    "idempotency_key",
    "requested_by",
    "edition_profile",
    "allow_external_side_effect"
  ]
}

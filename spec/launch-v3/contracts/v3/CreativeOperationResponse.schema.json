{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.viral-os.local/v3/CreativeOperationResponse.schema.json",
  "title": "CreativeOperationResponse",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "3.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^CV3-[0-9]{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "BLOCKED",
        "WAITING_FOR_APPROVAL",
        "SUCCEEDED",
        "FAILED",
        "WAITING_FOR_CAPABILITY"
      ]
    },
    "artifact_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_schema": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "blocker_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "operator_action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "side_effect_intent_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "implementation_note": {
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "job_id",
    "operation_id",
    "status",
    "artifact_id",
    "artifact_schema",
    "blocker_code",
    "operator_action",
    "side_effect_intent_id",
    "implementation_note"
  ]
}

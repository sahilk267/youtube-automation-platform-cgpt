{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.viral-os.local/v3/SoundMixSpec.schema.json",
  "title": "SoundMixSpec",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "3.0.0"
    },
    "mix_id": {
      "type": "string",
      "minLength": 1
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})+$"
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "track_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "NARRATION",
              "SOURCE_DIALOGUE",
              "MUSIC",
              "AMBIENCE",
              "SFX"
            ]
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "gain_db": {
            "type": "number",
            "minimum": -80,
            "maximum": 24
          },
          "duck_under_narration": {
            "type": "boolean"
          },
          "rights_decision_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "track_id",
          "role",
          "asset_id",
          "start_ms",
          "end_ms",
          "gain_db",
          "duck_under_narration",
          "rights_decision_id"
        ]
      },
      "minItems": 1
    },
    "measured_loudness_lufs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "measured_true_peak_dbfs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "voice_intelligibility_review": {
      "type": "string",
      "enum": [
        "PENDING",
        "PASS",
        "FAIL"
      ]
    },
    "rights_review": {
      "type": "string",
      "enum": [
        "PENDING",
        "PASS",
        "FAIL"
      ]
    }
  },
  "required": [
    "contract_version",
    "mix_id",
    "story_id",
    "locale",
    "tracks",
    "measured_loudness_lufs",
    "measured_true_peak_dbfs",
    "voice_intelligibility_review",
    "rights_review"
  ]
}

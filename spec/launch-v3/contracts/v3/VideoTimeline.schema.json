{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.viral-os.local/v3/VideoTimeline.schema.json",
  "title": "VideoTimeline",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "3.0.0"
    },
    "timeline_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})+$"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "width_px": {
      "type": "integer",
      "minimum": 128
    },
    "height_px": {
      "type": "integer",
      "minimum": 128
    },
    "fps_num": {
      "type": "integer",
      "minimum": 1
    },
    "fps_den": {
      "type": "integer",
      "minimum": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "lane": {
            "type": "string",
            "enum": [
              "PRIMARY_VISUAL",
              "INSERT",
              "GRAPHIC",
              "OVERLAY",
              "CAPTION",
              "BRAND",
              "DISCLOSURE",
              "VOICE",
              "SOURCE_AUDIO",
              "MUSIC",
              "SFX"
            ]
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "z_index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "segment_id",
          "lane",
          "artifact_id",
          "start_ms",
          "end_ms",
          "z_index"
        ]
      },
      "minItems": 1
    },
    "source_claim_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rights_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "render_graph_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qa_state": {
      "type": "string",
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL"
      ]
    },
    "human_approval_state": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    }
  },
  "required": [
    "contract_version",
    "timeline_id",
    "project_id",
    "story_id",
    "locale",
    "duration_ms",
    "width_px",
    "height_px",
    "fps_num",
    "fps_den",
    "segments",
    "source_claim_set_sha256",
    "rights_manifest_sha256",
    "render_graph_sha256",
    "qa_state",
    "human_approval_state"
  ]
}
